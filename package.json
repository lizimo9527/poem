{
  "name": "vue-demo1",
  "version": "1.0.0",
  "description": "Vue 3 项目脚手架",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "db:init": "node scripts/init-database.cjs",
    "db:migrate": "echo '使用 Supabase CLI: supabase db push'",
    "db:seed": "echo '运行数据库初始化脚本: npm run db:init'"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.75.0",
    "pinia": "^2.1.7",
    "vue": "^3.5.22",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitejs/plugin-vue": "^4.5.2",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^8.54.0",
    "eslint-plugin-vue": "^9.18.1",
    "prettier": "^3.1.0",
    "typescript": "^5.9.3",
    "vite": "^5.0.0",
    "vue-tsc": "^1.8.27"
  },
  "keywords": [
    "vue",
    "vue3",
    "typescript",
    "vite",
    "pinia",
    "vue-router"
  ],
  "author": "",
  "license": "MIT"
}
